[Unit]
Description = Media fix helper for Jellyfin custom actions
After = network-online.target

[Service]
Type = simple
User = nitin
Group = nitin
Environment = HOME=/home/nitin
Environment = PYTHONUNBUFFERED=1
WorkingDirectory = /home/nitin/mediafix-helper
ExecStart = /usr/bin/python3 /home/nitin/mediafix-helper/helper.py
Restart = no
TimeoutStopSec = 30
StandardOutput = journal
StandardError = journal

[Install]
WantedBy = multi-user.target
