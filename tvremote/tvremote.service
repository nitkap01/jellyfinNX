[Unit]
Description=TV Remote (JTV-13) - tvremote.home, INDIE :8496 (design preview stage)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 8496 --bind 0.0.0.0 --directory %h/projects/jellyfinNX/tvremote/designs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
