[Unit]
Description=TV Remote (JTV-13) - tvremote.home, INDIE :8496 -> Samsung TV 192.168.0.236
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/projects/jellyfinNX/tvremote/server.py
Environment=PORT=8496 TV_IP=192.168.0.236
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
